OPENAI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
X-NCP-APIGW-API-KEY-ID=
X-NCP-APIGW-API-KEY=

# paper or kis
BROKER_TYPE=paper
PAPER_INITIAL_CASH=50000000
PAPER_COMMISSION_RATE=0.00015

# KIS domestic stock API
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_CANO=
KIS_ACNT_PRDT_CD=01
KIS_ACCOUNT_TYPE=VIRTUAL
KIS_ENABLE_TRADING=false
KIS_TOKEN_FILE=.kis_token.json

# Bank of Korea ECOS Open API (Korean rates)
ECOS_API_KEY=

# Open DART (https://opendart.fss.or.kr/)
DART_API_KEY=

# KRX Open API (daily KOSPI/KOSDAQ market-cap universe)
KRX_API_KEY=

# Live trading scheduler (safe defaults)
# KR (default) or US. US mode uses America/New_York, USD, NASDAQ/SP500,
# and a separate strategy version/cache namespace.
TRADING_MARKET_REGION=KR
TRADING_DRY_RUN=true
TRADING_PRE_OPEN_AT=08:40
TRADING_CANDIDATE_SNAPSHOT_AT=08:55
TRADING_MARKET_OPEN_AT=09:00
TRADING_ENTRY_AT=09:05
TRADING_MARKET_CLOSE_AT=15:30
TRADING_POST_CLOSE_AT=15:40
# Optional US regular-session overrides (Eastern Time). Generic KRX times above
# are ignored when TRADING_MARKET_REGION=US.
TRADING_US_PRE_OPEN_AT=09:10
TRADING_US_CANDIDATE_SNAPSHOT_AT=09:20
TRADING_US_MARKET_OPEN_AT=09:30
TRADING_US_ENTRY_AT=09:35
TRADING_US_MARKET_CLOSE_AT=16:00
TRADING_US_POST_CLOSE_AT=16:10
TRADING_MONITOR_INTERVAL_SECONDS=60
TRADING_ML_FILTER_ENABLED=true
TRADING_ML_PROBABILITY_THRESHOLD=0.65
TRADING_MAX_CANDIDATES_PER_MARKET=10
TRADING_RECOMMENDATION_ANALYSIS_SHORTLIST=30
TRADING_RECOMMENDATION_FINAL_LIMIT=10
TRADING_RECOMMENDATION_UNIVERSE_PER_MARKET=100
TRADING_MAX_NEW_POSITIONS_PER_DAY=4
TRADING_MAX_DAILY_ORDERS=20
TRADING_MAX_ORDER_RETRIES=1
TRADING_DAILY_LOSS_LIMIT_PCT=0.03
TRADING_QUOTE_STALE_SECONDS=90
# KIS real minute OHLC monitoring. On API failure, keep monitoring with the
# current price unless fallback is explicitly disabled.
TRADING_KIS_MINUTE_BARS_ENABLED=true
TRADING_KIS_MINUTE_FALLBACK_TO_QUOTE=true
TRADING_KIS_COMPLETED_BARS_ONLY=true
TRADING_TRAILING_STOP_PCT=0.08
TRADING_REBALANCE_ENABLED=false
TRADING_REBALANCE_LLM_MODEL=gpt-5.6
TRADING_REBALANCE_MAX_TURNOVER_PCT=0.30
TRADING_REBALANCE_MAX_POSITION_PCT=0.20
TRADING_REBALANCE_MAX_SECTOR_PCT=0.40
TRADING_REBALANCE_MIN_CASH_PCT=0.10
TRADING_REBALANCE_MIN_CONFIDENCE=0.70
TRADING_REBALANCE_PROPOSAL_TTL_MINUTES=10
TRADING_REBALANCE_FILL_WAIT_SECONDS=30
TRADING_REBALANCE_REPORT_DIR=C:\Users\junku\OneDrive\Public\AI-Stock-Agent
# Slack에 전송할 OneDrive 공개 폴더 링크
TRADING_REBALANCE_REPORT_BASE_URL=https://1drv.ms/f/c/714ca3cac310f853/IgCM0r1KM0xSQb1g5kThUnk-AdzbHMoYLJZwWYglmBPg4qM?e=FM3eQu
TRADING_STATE_DB_PATH=data/trading/live_trading.sqlite3
TRADING_STRATEGY_VERSION=opening-ensemble-v1

# Slack fill notifications. Prefer an Incoming Webhook. Alternatively set a
# bot token (chat:write scope) and channel ID. Keep these values secret.
SLACK_NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_API_KEY=
SLACK_CHANNEL=
SLACK_TIMEOUT_SECONDS=10
